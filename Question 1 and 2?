
def main():
    P0 = float(input("Enter the amount to borrow: "))
    r = float(input("Enter the annual interest rate (in %): "))
    N = int(input("Enter the number of years: "))
    k = 12

    r = r / 100

    payment = P0 / ((1 - (1 + r / k) ** (-N * k)) / (r / k))

    balance = P0

    print("\nAMORTIZATION SCHEDULE")
    print("-" * 85)
    print("{:<10}{:<15}{:<15}{:<15}{:<20}".format(
        "Payment", "Amount", "Interest", "Principal", "Balance"))
    print("-" * 85)

    for number in range(1, N * k + 1):
        interest = balance * (r / k)
        principal = payment - interest
        balance = balance - principal

        if number == N * k or balance < 0:
            principal = principal + balance
            balance = 0

        print("{:<10}{:<15.2f}{:<15.2f}{:<15.2f}{:<20.2f}".format(
            number, payment, interest, principal, balance))

    print("-" * 85)
    print("Monthly payment: ${:.2f}".format(payment))


main()
